<%@ page contentType="text/html;charset=UTF-8" language="java" pageEncoding="UTF-8" %>
<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Accueil - Plateforme de Réservations</title>
    <meta name="description" content="Plateforme professionnelle de gestion de réservations et d'assignations de véhicules">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        <%@ include file="/assets/theme.css" %>
    </style>
</head>
<body>
    <%@ include file="/WEB-INF/jspf/site-header.jspf" %>

    <main class="hero">
        <!-- Carte image avec overlay moderne -->
        <div class="left-card">
            <div class="image-overlay">
                      <img class="vehicle-img" alt="Véhicule de luxe" src="data:image/jpeg;base64," alt="Vehicule" class="vehicle-img">
                <div class="image-caption">
                    <span class="caption-badge">Flotte 2026</span>
                </div>
            </div>
        </div>

        <!-- Panneau de réservation amélioré -->
        <aside class="reservation-panel home-text">
            <div class="panel-header">
                <span class="welcome-badge">Bienvenue</span>
                <h2>Plateforme de réservations</h2>
            </div>
            
            <p class="intro-text">
                <i class="fas fa-star" style="color: var(--gold);"></i>
                Gérez efficacement vos réservations et assignations de véhicules
            </p>

            <!-- Fonctionnalités en cartes -->
            <div class="features-grid">
                <div class="feature-item">
                    <i class="fas fa-calendar-check"></i>
                    <span>Suivi en temps réel</span>
                </div>
                <div class="feature-item">
                    <i class="fas fa-robot"></i>
                    <span>Assignation automatique</span>
                </div>
                <div class="feature-item">
                    <i class="fas fa-key"></i>
                    <span>Gestion des tokens</span>
                </div>
                <div class="feature-item">
                    <i class="fas fa-chart-line"></i>
                    <span>Statistiques détaillées</span>
                </div>
            </div>

            <!-- Points clés -->
            <ul class="benefits-list">
                <li>
                    <i class="fas fa-check-circle"></i>
                    <div>
                        <strong>Réservations simplifiées</strong>
                        <span>Interface intuitive pour vos clients</span>
                    </div>
                </li>
                <li>
                    <i class="fas fa-check-circle"></i>
                    <div>
                        <strong>Assignations optimisées</strong>
                        <span>Algorithmes intelligents de groupement</span>
                    </div>
                </li>
                <li>
                    <i class="fas fa-check-circle"></i>
                    <div>
                        <strong>Sécurité renforcée</strong>
                        <span>Contrôle d'accès par tokens</span>
                    </div>
                </li>
            </ul>

            <!-- Liens d'action -->
            <div class="action-buttons">
                <a href="${pageContext.request.contextPath}/backoffice" class="btn-primary">
                    <i class="fas fa-tachometer-alt"></i>
                    Backoffice
                </a>
                <a href="${pageContext.request.contextPath}/test-auth.html" class="btn-secondary">
                    <i class="fas fa-flask"></i>
                    Tests auth
                </a>
            </div>

            <!-- Statistiques rapides -->
            <div class="quick-stats">
                <div class="stat">
                    <span class="stat-number">150+</span>
                    <span class="stat-label">Véhicules</span>
                </div>
                <div class="stat">
                    <span class="stat-number">24/7</span>
                    <span class="stat-label">Support</span>
                </div>
                <div class="stat">
                    <span class="stat-number">99%</span>
                    <span class="stat-label">Satisfaction</span>
                </div>
            </div>
        </aside>
    </main>

    <%@ include file="/WEB-INF/jspf/site-footer.jspf" %>
</body>
</html>